# App
APP_ENV=development
APP_NAME=UK Carbon Intelligence
LOG_LEVEL=INFO
TIMEZONE=Europe/London

# Database - use the Compose service hostname in containers
POSTGRES_DB=uk_carbon_intelligence
POSTGRES_USER=ukci_app
POSTGRES_PASSWORD=change-this-local-development-password
DATABASE_URL=postgresql+psycopg://ukci_app:change-this-local-development-password@db:5432/uk_carbon_intelligence

# NESO public API (no API key is currently required)
NESO_API_BASE_URL=https://api.carbonintensity.org.uk
NESO_REQUEST_TIMEOUT_SECONDS=10
NESO_POLL_INTERVAL_MINUTES=30

# Optional AI - disabled by default
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional integrations
MCP_ENABLED=false
