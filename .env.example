# Application
ENVIRONMENT=development
APP_NAME=UK Carbon Intelligence API
APP_VERSION=0.1.0
TIMEZONE=Europe/London

# Database - use the Compose service hostname in containers
POSTGRES_DB=carbon_intelligence
POSTGRES_USER=carbon
POSTGRES_PASSWORD=change-this-local-development-password
DATABASE_URL=postgresql+asyncpg://carbon:change-this-local-development-password@db:5432/carbon_intelligence

# NESO public API (no API key is currently required)
NESO_API_BASE_URL=https://api.carbonintensity.org.uk
NESO_TIMEOUT_SECONDS=12
COLLECTION_INTERVAL_SECONDS=1800
SCHEDULER_ENABLED=false
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
